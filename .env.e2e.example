# Copiar a .env.e2e y completar. No versionar credenciales reales.
E2E_BASE_URL=http://localhost:3000
E2E_API_URL=http://localhost:4000/api

E2E_EMAIL=usuario-pruebas@elmorro.com
E2E_PASSWORD=cambiar-esta-clave

# Opcional: si se omite, se usa la primera empresa activa.
# E2E_COMPANY_ID=uuid-empresa
# E2E_COMPANY_NAME=El Morro

# Flujos que modifican datos.
E2E_MUTATIONS=0
E2E_SALES_FLOW=0

# Datos para el flujo de venta.
E2E_PRODUCT_NAME=Producto de prueba
E2E_CUSTOMER_DOC=12345678
E2E_PAYMENT_ACCOUNT_NAME=Efectivo
E2E_SALE_AMOUNT=118
